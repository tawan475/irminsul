<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The underlying network's DNS servers (GameVpnService). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The VPN's allowed list names the game, which needs it visible (API 30+). -->
    <queries>
        <package android:name="com.miHoYo.GenshinImpact" />
    </queries>

    <application
        android:label="Irminsul (spike)"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GameVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
